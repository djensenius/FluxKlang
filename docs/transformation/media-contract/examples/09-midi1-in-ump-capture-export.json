{
  "contract": "fluxklang.media", "version": 1, "exampleId": "ex.09-midi1-in-ump-capture-export",
  "title": "MIDI 1.0 device captured as UMP: native MIDI 1 words and OS-upconverted MIDI 2 words both keep MIDI 1 fidelity",
  "covers": ["midi1InUmp", "smfExportLossless"],
  "notes": [
    "str.keys-b reads the same MIDI 1.0 endpoint through a MIDI 2.0 port: velocity 0xC924 is assumed to be the OS upscale of 100 (open question 8), not 16-bit data.",
    "Effective fidelity comes from the endpoint protocol property, never from inspecting values."
  ],
  "clocks": {
    "host": {"timebaseNumer": 125, "timebaseDenom": 3}, "sample": [{"clockId": "smp.main", "nominalRate": 48000}],
    "musical": {"clockId": "mus.main", "ticksPerQuarter": 15360, "meter": {"numerator": 4, "denominator": 4}, "musicalMap": [{"atTicks": 0, "microsPerQuarter": 500000}]}
  },
  "streams": [
    {"streamId": "str.keys-a", "ordinal": 0, "media": "midi", "direction": "capture"},
    {"streamId": "str.keys-b", "ordinal": 1, "media": "midi", "direction": "capture"}
  ],
  "initialGenerations": {
    "sampleClock/smp.main": 1, "transport/mus.main": 1, "musicalMap/mus.main": 1, "context/ctx.main": 1
  },
  "timeline": [
    {"seq": 1, "kind": "anchor", "sampleClock": "smp.main", "generation": 1, "frame": 0, "hostTicks": 2400000000, "transport": 1, "musicalTicks": 0},
    {"seq": 2, "kind": "midiCapture", "stream": "str.keys-a", "ump": ["0x20903C64"], "hostTicks": 2412000000, "frame": 24000, "musicalTicks": 15360, "endpointProtocol": "midi1", "portProtocol": "midi1", "translatedBy": "none", "effective": "midi1"},
    {"seq": 3, "kind": "midiCapture", "stream": "str.keys-a", "ump": ["0x20803C00"], "hostTicks": 2424000000, "frame": 48000, "musicalTicks": 30720, "endpointProtocol": "midi1", "portProtocol": "midi1", "translatedBy": "none", "effective": "midi1"},
    {"seq": 4, "kind": "midiCapture", "stream": "str.keys-b", "ump": ["0x40903C00", "0xC9240000"], "hostTicks": 2436000000, "frame": 72000, "musicalTicks": 46080, "endpointProtocol": "midi1", "portProtocol": "midi2", "translatedBy": "os", "effective": "midi1"},
    {"seq": 5, "kind": "midiCapture", "stream": "str.keys-b", "ump": ["0x40B00700", "0x80000000"], "hostTicks": 2442000000, "frame": 84000, "musicalTicks": 53760, "endpointProtocol": "midi1", "portProtocol": "midi2", "translatedBy": "os", "effective": "midi1"},
    {"seq": 6, "kind": "midiCapture", "stream": "str.keys-b", "ump": ["0x40803C00", "0x00000000"], "hostTicks": 2448000000, "frame": 96000, "musicalTicks": 61440, "endpointProtocol": "midi1", "portProtocol": "midi2", "translatedBy": "os", "effective": "midi1"},
    {"seq": 7, "kind": "export", "exportId": "exp.smf", "streams": ["str.keys-a", "str.keys-b"], "format": "smf", "smfFormat": 1, "division": 960, "lossless": true, "losses": {}},
    {"seq": 8, "kind": "export", "exportId": "exp.ump", "streams": ["str.keys-a", "str.keys-b"], "format": "nativeUmp", "lossless": true, "losses": {}}
  ]
}
