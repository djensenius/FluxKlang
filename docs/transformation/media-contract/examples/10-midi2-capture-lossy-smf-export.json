    {"seq": 5, "kind": "midiCapture", "stream": "str.synth", "ump": ["0x40904000", "0x01000000"], "hostTicks": 2430000000, "frame": 60000, "musicalTicks": 38400, "endpointProtocol": "midi2", "portProtocol": "midi2", "translatedBy": "none", "effective": "midi2"},
