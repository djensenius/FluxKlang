    {"seq": 3, "kind": "midiCapture", "stream": "str.synth", "ump": ["0x40603C00", "0x80400000"], "hostTicks": 2418000000, "frame": 36000, "musicalTicks": 23040, "endpointProtocol": "midi2", "portProtocol": "midi2", "translatedBy": "none", "effective": "midi2"},
