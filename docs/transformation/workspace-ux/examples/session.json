    {"formFactor": "tablet", "layout": "sidebar + canvas + inspector (regular width)"},
    {"formFactor": "phone", "layout": "compact lists, pickers and sheets"}
  ],
  "windows": [
    {"id": "win.wiring", "surface": "wiring", "host": "per.host-a"},
    {"id": "win.perform", "surface": "perform", "host": "per.host-a"}
