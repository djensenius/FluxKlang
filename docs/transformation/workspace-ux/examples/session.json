    {"node": "nod.mic", "state": "mapped", "route": "rte.mic-in"},
    {"node": "nod.pads", "state": "stale", "route": "rte.pads"},
    {"node": "nod.synth", "state": "ready"},
    {"node": "nod.verb", "state": "ready"},
    {"node": "nod.echo", "state": "missing"},
    {"node": "nod.mains", "state": "mapped", "route": "rte.mains"},
